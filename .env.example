# StudyGolang 环境变量配置模板
# 复制此文件为 .env 并填入实际值

# ==========================================
# 数据库配置 (MySQL)
# ==========================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=studygolang

# ==========================================
# Redis 配置
# ==========================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# ==========================================
# 安全配置
# ==========================================
# JWT Secret（新版 Token，生产环境必须配置，至少 32 字节）
JWT_SECRET=please_generate_a_64_char_random_jwt_secret_here_for_production

# Token 签名盐值（64位随机字符串）- 必须修改！
TOKEN_SALT=please_generate_a_64_char_random_string_here
# 退订邮件 token key（19位）
UNSUBSCRIBE_TOKEN_KEY=please_change_this_key
# 注册激活邮件 sign salt（18位）
ACTIVATE_SIGN_SALT=please_change_this_salt

# ==========================================
# 邮件配置 (主邮件)
# ==========================================
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=your_smtp_password
SMTP_HOST=smtp.example.com
SMTP_PORT=25

# ==========================================
# 邮件配置 (认证邮件)
# ==========================================
AUTH_SMTP_USERNAME=your_auth_email@example.com
AUTH_SMTP_PASSWORD=your_auth_smtp_password
AUTH_SMTP_HOST=smtp.example.com
AUTH_SMTP_PORT=587

# ==========================================
# 七牛云配置（可选）
# ==========================================
QINIU_ACCESS_KEY=your_qiniu_access_key
QINIU_SECRET_KEY=your_qiniu_secret_key
QINIU_BUCKET_NAME=your_bucket_name

# ==========================================
# 微信配置（可选）
# ==========================================
WECHAT_APPID=your_wechat_appid
WECHAT_APPSECRET=your_wechat_appsecret

# ==========================================
# GitHub OAuth 配置（可选）
# ==========================================
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# ==========================================
# GCTT 配置（可选）
# ==========================================
GCTT_TOKEN_SECRET=your_gctt_token_secret
